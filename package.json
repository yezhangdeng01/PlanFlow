{
  "name": "obsidian-planflow",
  "version": "1.0.4",
  "description": "基于Obsidian的计划自动拆解行动系统：年度计划自动拆解，量化任务自动流转，每日行动打卡/周/月/年度目标/看板/甘特六视图目标追踪，自统计激励系统",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "planning",
    "habits",
    "tasks"
  ],
  "author": "JCH",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "eslint": "^10.9.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0",
    "ws": "^8.21.3"
  }
}
